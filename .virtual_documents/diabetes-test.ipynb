# plt.show()


# ages = df.loc[df["alcohol_consumption"].isin(["Regular",'Occasional']),"age"]

# average = ages.mean()
# print(average)


activity_map = {
    "Sedentary": 0,
    "Moderate": 1,
    "Active": 2
}

df["physical_activity_level"] = df["physical_activity_level"].map(activity_map)


column1 = pd.get_dummies(df['family_history_diabetes']).astype(int)


del df['family_history_diabetes']


df = pd.concat([df,column1],axis=1)





smokers_map = {
    "Never": 0,
    "Former": 1,
    "Current": 2
}

df["smoking_status"] = df["smoking_status"].map(smokers_map)


alcohol_map = {
    "Never": 0,
    "Occasional": 1,
    "Regular": 2
}

df["alcohol_consumption"] = (
    df["alcohol_consumption"]
    .map(alcohol_map)
   
)


df.columns





# df['diabetes_risk']


Y= df['diabetes_risk']


del df['diabetes_risk']


X = df





X.isnull().sum()


# model = SVC(kernel='linear',C=1)




model = LogisticRegression()



X_train, X_test, y_train, y_test = train_test_split(
    X,
    Y,
    test_size=0.2,
    # random_state=42,
)



from sklearn.model_selection import cross_val_score 

log_model = LogisticRegression(max_iter=1000) 
log_scores = cross_val_score(log_model, X_train, y_train, cv=5) 
print("Accuracy for each of the 5 folds:", log_scores)


model.fit(X_train,y_train)



model.coef_


y_pred = model.predict(X_test)


len(y_pred)


print("Accuracy:", accuracy_score(y_test, y_pred))
print(classification_report(y_test, y_pred))





