#     df["alcohol_consumption"].isin(["Regular",'Occasional']),
#     "age"
# ]

# average = ages.mean()
# print(average)


# df.loc[
#     (df["age"] > 40) & (df["smoking_status"].isna()),
#     "smoking_status"
# ] = "Current"


df.loc[
    (df["smoking_status"] == "Never") & (df["alcohol_consumption"].isna()),
    "alcohol_consumption"
] = "Never"


# df.loc[
#     (df["alcohol_consumption"] == "Never") & (df["smoking_status"].isna()),
#     "smoking_status"
# ]


# df.loc[
#     (df["age"] > 40) & (df["alcohol_consumption"].isna()),
#     "alcohol_consumption"
# ] = "Regular"



df.isnull().sum()


df = df.dropna()


# cross_tab = pd.crosstab(
#     df["smoking_status"],
#     df["alcohol_consumption"]
# )

# sns.heatmap(
